@startuml Diagrama_de_Classes
!theme plain
skinparam backgroundColor #FAFAFA
skinparam ClassBackgroundColor #EBF5FB
skinparam ClassBorderColor #2980B9
skinparam ClassHeaderBackgroundColor #2980B9
skinparam ClassHeaderFontColor #FFFFFF
skinparam ArrowColor #2C3E50
skinparam PackageBorderColor #7F8C8D
skinparam PackageBackgroundColor #FDFEFE
skinparam PackageFontSize 13
skinparam PackageFontStyle bold

title <b>Diagrama de Classes</b>\nSistema de Gestão Olímpica

' =====================
' CLASSES DE ENTIDADE
' =====================

class Pais {
  - id: Long
  - nome: String
  - codigoIOC: String
  - bandeira: String
  --
  + getNome(): String
  + getMedalhas(): List<Medalha>
  + getTotalOuro(): int
  + getTotalPrata(): int
  + getTotalBronze(): int
}

class Atleta {
  - id: Long
  - nome: String
  - dataNascimento: Date
  - documento: String
  - pais: Pais
  --
  + getNome(): String
  + getInscricoes(): List<Inscricao>
  + getPaisRepresentado(modalidade: String): Pais
}

class Local {
  - id: Long
  - nome: String
  - endereco: String
  - capacidade: int
  - tipo: String
  --
  + isDisponivel(data: Date, hora: Time): boolean
  + getAgenda(): List<Competicao>
}

class Competicao {
  - id: Long
  - nomeModalidade: String
  - data: Date
  - horario: Time
  - status: StatusCompeticao
  --
  + getAtletasInscritos(): List<Atleta>
  + getResultado(): Resultado
  + isEncerrada(): boolean
}

class Inscricao {
  - id: Long
  - dataInscricao: Date
  - paisRepresentado: Pais
  - status: StatusInscricao
  --
  + cancelar(): void
  + validar(): boolean
}

class Resultado {
  - id: Long
  - dataRegistro: Date
  - homologado: boolean
  --
  + getVencedor(): Atleta
  + getSegundoLugar(): Atleta
  + getTerceiroLugar(): Atleta
  + homologar(): void
}

class Classificacao {
  - posicao: int
  - pontuacao: double
  - tipoMedalha: TipoMedalha
  --
  + getMedalha(): TipoMedalha
}

' =====================
' CLASSES DE SERVIÇO
' =====================

class CompetitionService {
  + cadastrarCompeticao(dto: CompetitionDTO): Competicao
  + editarCompeticao(id: Long, dto: CompetitionDTO): Competicao
  + cancelarCompeticao(id: Long): void
  + listarCompeticoes(): List<Competicao>
  + buscarPorModalidade(nome: String): List<Competicao>
}

class InscricaoService {
  + inscreverAtleta(atletaId: Long, competicaoId: Long): Inscricao
  + cancelarInscricao(id: Long): void
  + validarPaisRepresentado(atletaId: Long, modalidade: String, paisId: Long): boolean
  + listarInscricoes(atletaId: Long): List<Inscricao>
}

class LocalService {
  + alocarLocal(localId: Long, competicaoId: Long): boolean
  + liberarLocal(localId: Long, competicaoId: Long): void
  + verificarDisponibilidade(localId: Long, data: Date, hora: Time): boolean
  + consultarAgenda(localId: Long): List<Competicao>
}

class ResultadoService {
  + registrarResultado(competicaoId: Long, classificacoes: List): Resultado
  + homologarResultado(resultadoId: Long): void
  + consultarResultado(competicaoId: Long): Resultado
}

class RelatorioService {
  + gerarRelatorioMedalhas(): RelatorioMedalhas
  + rankingPaises(): List<RankingPais>
  + exportarRelatorio(formato: String): byte[]
}

' =====================
' INTERFACES DE REPOSITÓRIO
' =====================

interface AtletaRepository {
  + findById(id: Long): Atleta
  + findByPais(paisId: Long): List<Atleta>
  + save(atleta: Atleta): Atleta
}

interface CompetitionRepository {
  + findById(id: Long): Competicao
  + findByModalidade(nome: String): List<Competicao>
  + findByData(data: Date): List<Competicao>
  + save(comp: Competicao): Competicao
}

interface LocalRepository {
  + findById(id: Long): Local
  + findDisponivel(data: Date, hora: Time): List<Local>
  + save(local: Local): Local
}

interface ResultadoRepository {
  + findByCompeticao(id: Long): Resultado
  + save(resultado: Resultado): Resultado
}

' =====================
' ENUMERAÇÕES
' =====================

enum StatusCompeticao {
  AGENDADA
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

enum StatusInscricao {
  PENDENTE
  CONFIRMADA
  CANCELADA
}

enum TipoMedalha {
  OURO
  PRATA
  BRONZE
}

' =====================
' RELACIONAMENTOS — ENTIDADES
' =====================

Competicao "1" *-- "1" Resultado         : contém
Competicao "1" o-- "1" Local             : realizada em
Competicao "1" *-- "0..*" Inscricao      : possui
Resultado "1"  *-- "1..3" Classificacao  : contém
Classificacao "1" --> "1" Atleta         : refere-se a
Inscricao "0..*" --> "1" Atleta          : pertence a
Inscricao "0..*" --> "1" Pais            : representa
Atleta "0..*"    --> "1" Pais            : pertence a
Competicao       --> StatusCompeticao
Inscricao        --> StatusInscricao
Classificacao    --> TipoMedalha

' =====================
' RELACIONAMENTOS — SERVIÇOS → REPOSITÓRIOS
' =====================

CompetitionService ..> CompetitionRepository : usa
InscricaoService   ..> AtletaRepository      : usa
InscricaoService   ..> CompetitionRepository : usa
LocalService       ..> LocalRepository       : usa
ResultadoService   ..> ResultadoRepository   : usa
RelatorioService   ..> ResultadoRepository   : usa

@enduml
