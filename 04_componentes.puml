@startuml Diagrama_de_Componentes
!theme plain
skinparam backgroundColor #FAFAFA
skinparam ComponentBackgroundColor #EBF5FB
skinparam ComponentBorderColor #2980B9
skinparam ArrowColor #2C3E50
skinparam InterfaceBackgroundColor #F9E79F
skinparam InterfaceBorderColor #F39C12
skinparam DatabaseBackgroundColor #FDEDEC
skinparam DatabaseBorderColor #E74C3C
skinparam PackageBorderColor #7F8C8D
skinparam PackageBackgroundColor #FDFEFE
skinparam NodeBackgroundColor #EAFAF1
skinparam NodeBorderColor #27AE60

title <b>Diagrama de Componentes</b>\nSistema de Gestão Olímpica

' =====================
' CAMADA: FRONTEND
' =====================
package "Camada de Apresentação (Frontend)" #EAF2FF {

  component "Interface Web\n(SPA React)" as UI {
    portin " " as UI_IN
  }

  component "App Mobile\n(React Native)" as Mobile

  component "Portal\nAdministrativo" as AdminPortal
}

' =====================
' CAMADA: API GATEWAY
' =====================
package "API Gateway / BFF" #FEF9E7 {
  component "API Gateway" as Gateway {
    portin "REST /api/v1" as GW_IN
    portout " " as GW_OUT
  }
  component "Autenticação\n& Autorização\n(OAuth 2.0 / JWT)" as Auth
}

' =====================
' CAMADA: MICROSERVIÇOS / MÓDULOS
' =====================
package "Camada de Negócio (Backend)" #EAF7EA {

  component "Módulo de\nCompetições" as ModComp {
    portin "ICompetitionService" as MC_IN
    portout "ILocalService" as MC_OUT
  }

  component "Módulo de\nInscrições" as ModInsc {
    portin "IInscricaoService" as MI_IN
    portout "IValidacao" as MI_OUT
  }

  component "Módulo de\nAlocação de Locais" as ModAloc {
    portin "ILocalService" as MA_IN
  }

  component "Módulo de\nResultados" as ModResult {
    portin "IResultadoService" as MR_IN
  }

  component "Módulo de\nRelatórios" as ModRel {
    portin "IRelatorioService" as MRL_IN
    portout "IExport" as MRL_OUT
  }

  component "Serviço de\nNotificações" as Notif

}

' =====================
' CAMADA: DADOS
' =====================
package "Camada de Dados" #FDEDEC {

  database "Banco de Dados\nPrincipal\n(PostgreSQL)" as DB

  database "Cache\n(Redis)" as Cache

  component "ORM / Data\nAccess Layer" as DAL

  component "Serviço de\nExportação\n(PDF / Excel)" as Export

}

' =====================
' RELACIONAMENTOS
' =====================

' Frontend → Gateway
UI --> Gateway : HTTPS/REST
Mobile --> Gateway : HTTPS/REST
AdminPortal --> Gateway : HTTPS/REST

' Gateway → Auth
Gateway --> Auth : valida token

' Gateway → Módulos
Gateway --> ModComp : roteia /competicoes
Gateway --> ModInsc : roteia /inscricoes
Gateway --> ModAloc : roteia /locais
Gateway --> ModResult : roteia /resultados
Gateway --> ModRel : roteia /relatorios

' Relacionamentos entre Módulos
ModComp --> ModAloc : verifica disponibilidade
ModInsc --> ModComp : consulta competição
ModInsc --> ModAloc : <<include>> valida conflito
ModResult --> ModComp : atualiza status
ModRel --> ModResult : consulta dados
ModRel --> ModComp : consolida medalhas

' Módulos → Notificações
ModInsc --> Notif : envia confirmação
ModResult --> Notif : notifica resultado

' Módulos → DAL
ModComp --> DAL
ModInsc --> DAL
ModAloc --> DAL
ModResult --> DAL
ModRel --> DAL

' DAL → BD
DAL --> DB : leitura/escrita
DAL --> Cache : leitura rápida

' Relatório → Export
ModRel --> Export : gera arquivo
Export --> MRL_OUT : PDF / Excel

@enduml
